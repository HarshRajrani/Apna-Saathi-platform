# ============================================
# Server Environment Configuration (.env)
# ============================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas for Production / Render)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
# Make sure to allow IP 0.0.0.0/0 in MongoDB Atlas Network Access!
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/apna_saathi?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=apna_saathi_jwt_secret_dev_key_2026_super_secure
JWT_EXPIRE=7d

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:3000

# Razorpay Integration (Test Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Demo / Seed Password for Default Users
SEED_PASSWORD=Password123!
